{
  "private": true,
  "repository": "github:frqstbite/object-pool",
  "scripts": {
    "docs": "pnpm moonwave dev",
    "lint": "selene .",
    "format": "pnpm stylua .",
    "prepare": "husky; rokit install"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912",
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@johnnymorganz/stylua-bin": "^2.4.0",
    "husky": "^9.1.7",
    "moonwave": "^1.3.0"
  },
  "release": {
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "sed -i 's/^version = \".*\"/version = \"${nextRelease.version}\"/' wally.toml; rojo build -o 'ObjectPool-v${nextRelease.version}.rbxm'",
          "publishCmd": "wally publish --token $WALLY_TOKEN"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": "wally.toml",
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": "*.rbxm"
        }
      ]
    ]
  }
}